+impl Session {
+    /// The phone's own ping timestamps, the first three of each session: whether they are its
+    /// wall clock (nanoseconds since 1970, about 1.79e18 in 2026) or a monotonic clock decides
+    /// whether the phone can set the car's clock. The unit's clock is
+    /// printed beside it for comparison.
+    fn log_phone_ping(&mut self, timestamp_ns: i64) {
+        if self.phone_pings_logged >= 3 {
+            return;
+        }
+        self.phone_pings_logged += 1;
+        let unit_ns = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_nanos() as i128)
+            .unwrap_or(0);
+        println!(
+            "[Session] phone ping {}: timestamp_ns {timestamp_ns} (unit clock {unit_ns} ns since 1970; difference {} s)",
+            self.phone_pings_logged,
+            (timestamp_ns as i128 - unit_ns) / 1_000_000_000
+        );
+    }
+}
